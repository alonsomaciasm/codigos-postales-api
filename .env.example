# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNOS (.env.example)
# API de Códigos Postales de México (SEPOMEX / datos.gob.mx)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Metadata del Proyecto
# ------------------------------------------------------------------------------
PROJECT_NAME="API Códigos Postales de México"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# 2. Servidor ASGI & Host
# ------------------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8000
WORKERS=2

# ------------------------------------------------------------------------------
# 3. Base de Datos SQLite (WAL Mode)
# ------------------------------------------------------------------------------
DB_PATH="sepomex.db"
DB_BUSY_TIMEOUT_MS=5000
DB_CACHE_SIZE_KB=-64000  # 64MB Cache en RAM

# ------------------------------------------------------------------------------
# 4. Pipeline de Ingesta SEPOMEX / datos.gob.mx
# ------------------------------------------------------------------------------
DATOS_GOB_MX_DATASET_URL="https://datos.gob.mx/busca/dataset/codigo-postal-mexicano"
SEPOMEX_EXPORT_URL="https://www.correosdemexico.gob.mx/SSLServicios/ConsultaCP/CodigoPostal_Exportar.aspx"
INGEST_MAX_RETRIES=3
INGEST_RETRY_BACKOFF_SEC=3.0

# ------------------------------------------------------------------------------
# 5. Ciberseguridad & Autenticación (API Key & JWT)
# ------------------------------------------------------------------------------
# Si es True, exige X-API-Key o JWT Bearer token en cada petición HTTP
REQUIRE_AUTH=False
# Lista de API Keys válidas autorizadas (separadas por coma)
API_KEYS="key-dev-12345,key-prod-67890"
# Clave secreta para la firma y verificación de tokens JWT
JWT_SECRET_KEY="super-secret-jwt-key-sepomex-api"
# Algoritmo de encriptación para el token JWT
JWT_ALGORITHM="HS256"
# Vigencia del token JWT emitido en horas
JWT_EXPIRE_HOURS=24

# ------------------------------------------------------------------------------
# 6. Configuración CORS (Cross-Origin Resource Sharing) para Producción
# ------------------------------------------------------------------------------
# Dominios permitidos para CORS (separados por coma o '*' para permitir todos)
# En desarrollo: "*"
# En producción: "https://midominio.com,https://app.midominio.com,https://admin.midominio.com"
CORS_ORIGINS="*"

# Permitir envío de credenciales o cookies en peticiones Cross-Origin
CORS_ALLOW_CREDENTIALS=True

# Métodos HTTP permitidos para CORS (separados por coma o '*' para todos)
# En desarrollo: "*"
# En producción: "GET,POST,OPTIONS"
CORS_ALLOW_METHODS="*"

# Headers HTTP permitidos en peticiones CORS (separados por coma o '*' para todos)
# En desarrollo: "*"
# En producción: "Content-Type,Authorization,X-API-Key,X-Correlation-ID"
CORS_ALLOW_HEADERS="*"

# ------------------------------------------------------------------------------
# 7. Performance, Caché LRU & Compresión HTTP GZip
# ------------------------------------------------------------------------------
# Número máximo de Códigos Postales en caché LRU en memoria RAM
CACHE_LRU_MAXSIZE=1024
# Tamaño mínimo en bytes para activar la compresión GZip en respuestas HTTP
GZIP_MIN_SIZE=1000
# Límite máximo en bytes para el cuerpo de la petición HTTP (1048576 = 1MB)
MAX_BODY_BYTES_LIMIT=1048576

# ------------------------------------------------------------------------------
# 8. Reportes PDF & Procesamiento en Lote (Batch)
# ------------------------------------------------------------------------------
# Título y Subtítulo por defecto en reportes PDF exportados
PDF_DEFAULT_TITLE="Reporte Geográfico Ejecutivo - SEPOMEX"
PDF_DEFAULT_SUBTITLE="Ficha Técnica Oficial de Entidad Federativa"
# Límite máximo de ítems permitidos por petición POST en validación masiva en lote
BATCH_MAX_ITEMS=100

# ------------------------------------------------------------------------------
# 8. Rate Limiting (Control de Tasa de Peticiones)
# ------------------------------------------------------------------------------
# Límite global de peticiones por minuto por IP/Cliente
RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------------------------------------
# 8. Logging & Auditoría Empresarial
# ------------------------------------------------------------------------------
LOG_LEVEL="INFO"
LOG_DIR="logs"
LOG_ROTATION="00:00"      # Rotación diaria a las 00:00
LOG_RETENTION="30 days"  # Retención por 30 días

# ------------------------------------------------------------------------------
# 9. Cláusula de Atribución Legal CC BY 4.0
# ------------------------------------------------------------------------------
ATTRIBUTION_TEXT="Esta API utiliza y procesa información geográfica y de códigos postales proveniente del catálogo oficial publicado por el Servicio Postal Mexicano (SEPOMEX) a través de datos.gob.mx bajo la licencia Creative Commons Attribution 4.0 International."
ATTRIBUTION_URL="https://creativecommons.org/licenses/by/4.0/"
SOURCE_URL="https://datos.gob.mx"
